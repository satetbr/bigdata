	column RENDABRUTA =
			
			'dados'[RDPC] * 'dados'[PESOTOT]
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 2eb09a59-09c2-4cb6-b716-6b7cc7bb647a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	column RENDAPC =
			
			DIVIDE('dados'[RENDABRUTA],'dados'[PESOTOT])
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: fc2a47cf-faf0-426e-bb98-9a911d113d63
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	partition dados = m
		mode: import
		source =
				let
				    Fonte = Excel.Workbook(File.Contents("C:\Users\Matheus\Downloads\dados_rj\RM 63300 Rio de Janeiro - Base UDH 2000_2010.xlsx"), null, true),
