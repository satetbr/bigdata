table dados
	lineageTag: b4ff208b-1985-47fd-9e36-653fa350877a

	measure 'HOMEM15A19 mais HOMEM20A24' =
			
			SUM('dados'[HOMEM15A19]) + SUM('dados'[HOMEM20A24])
